from flask import Flask, render_template, request
from emotion_detection.emotion_detection import emotion_detector

app = Flask("Emotion Detector")

@app.route("/emotionDetector")
def sent_analyzer():
    """
    Menerima teks dari aplikasi web, memanggil fungsi emotion_detector,
    dan menangani error jika input tidak valid.
    """
    # Mengambil teks dari parameter URL 'textToAnalyze'
    text_to_analyze = request.args.get('textToAnalyze')

    # Menjalankan fungsi deteksi emosi
    response = emotion_detector(text_to_analyze)

    # Mengekstrak dominant_emotion untuk pengecekan error
    dominant_emotion = response['dominant_emotion']

    # --- LOGIKA ERROR HANDLING (Task 7) ---
    # Jika input kosong atau tidak valid, detector akan mengembalikan None
    if dominant_emotion is None:
        return "Invalid text! Please try again!."

    # Jika valid, format respon untuk ditampilkan ke user
    return (
        f"For the given statement, the system response is 'anger': {response['anger']}, "
        f"'disgust': {response['disgust']}, 'fear': {response['fear']}, "
        f"'joy': {response['joy']} and 'sadness': {response['sadness']}. "
        f"The dominant emotion is {dominant_emotion}."
    )

@app.route("/")
def render_index_page():
    """
    Merender halaman utama aplikasi.
    """
    return render_template('index.html')

if __name__ == "__main__":
    # Menjalankan aplikasi pada port 5000
    app.run(host="0.0.0.0", port=5000)
